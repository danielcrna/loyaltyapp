# ───────────── Básico ─────────────
DATABASE_URL="postgresql://loyalty:loyalty@localhost:5432/loyalty"
# URL pública HTTPS de tu plataforma (obligatoria en producción: Apple y Google la usan)
APP_URL="http://localhost:3000"   # producción: p. ej. https://lealtio.wabistudio.com.mx
NEXT_PUBLIC_APP_NAME="Lealt.io"
# Cadena aleatoria larga (openssl rand -hex 32)
SESSION_SECRET=""
# Secreto para ejecutar /api/cron (automatizaciones diarias)
CRON_SECRET=""
# Correos que serán superadmin al iniciar sesión (separados por coma)
SUPERADMIN_EMAILS=""
TRIAL_DAYS=14

# ───────────── Apple Wallet (requiere Apple Developer Program) ─────────────
# Ver docs/CONFIGURACION.md. Los certificados pueden ir en base64 o como PEM con \n.
APPLE_PASS_TYPE_ID=""            # ej. pass.mx.com.wabistudio.lealtio
APPLE_TEAM_ID=""                 # 10 caracteres, en developer.apple.com > Membership
APPLE_PASS_CERT=""               # certificado del Pass Type ID (PEM, base64)
APPLE_PASS_KEY=""                # llave privada (PEM, base64)
APPLE_PASS_KEY_PASSPHRASE=""     # si la llave está cifrada
APPLE_WWDR_CERT=""               # Apple WWDR G4 (PEM, base64)
# APNS_HOST="api.push.apple.com"

# ───────────── Google Wallet (gratis) ─────────────
GOOGLE_WALLET_ISSUER_ID=""       # Google Pay & Wallet Console
# Opción sencilla: el archivo JSON completo de la cuenta de servicio, en base64
#   base64 -i archivo.json | tr -d '\n' | pbcopy
GOOGLE_SA_JSON=""
# …o por separado:
GOOGLE_SA_EMAIL=""               # client_email del JSON
GOOGLE_SA_PRIVATE_KEY=""         # private_key del JSON (PEM o base64)

# ───────────── Stripe (cobro de suscripciones a los negocios) ─────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""          # price_... del plan Básico
STRIPE_PRICE_PRO=""
STRIPE_PRICE_BUSINESS=""
